---
interface Props {
  email?: string;
  githubUrl?: string;
  linkedinUrl?: string;
  mediumUrl?: string;
}

const {
  email = "antoniobalderramamendoza@gmail.com",
  githubUrl = "https://github.com/fredantb/",
  linkedinUrl = "https://linkedin.com/in/Frederick-Antonio-Balderrama-Mendoza/",
  mediumUrl = "https://medium.com/@antoniobalderramamendoza",
} = Astro.props;
---

<section id="contact" class="relative py-20 bg-slate-950 text-slate-100 overflow-hidden border-t border-slate-800/80">
  <!-- Subtle Background Grid & Glow Overlay -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b15_1px,transparent_1px),linear-gradient(to_bottom,#1e293b15_1px,transparent_1px)] bg-[size:3rem_3rem] pointer-events-none"></div>
  <div class="absolute -bottom-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-6 relative z-10">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-xs uppercase tracking-widest text-sky-400 font-semibold mb-2">Connect &amp; Collaborate</h2>
      <h3 class="text-3xl md:text-4xl font-extrabold tracking-tight text-slate-100">
        Let's build something <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 via-purple-400 to-indigo-400">extraordinary</span>.
      </h3>
      <p class="mt-4 text-slate-400 text-sm md:text-base leading-relaxed">
        Whether you want to discuss polyglot micro-frontend architectures, WebAssembly integrations, cloud engineering, or potential projects, my inbox is open.
      </p>
    </div>

    <!-- Main Grid Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
      
      <!-- Direct Contact Card (Right-Angled Retro Glasses CTA) -->
<div class="p-8 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-sky-500/50 transition-all duration-300 flex flex-col justify-between shadow-xl">
  <div>
    <div class="w-12 h-12 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 mb-6">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 002-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
      </svg>
    </div>
    <h4 class="text-xl font-bold text-slate-100 mb-2">Send a Message</h4>
    <p class="text-slate-400 text-sm leading-relaxed mb-6">
      Prefer direct email? Reach out anytime and I'll get back to you as soon as possible.
    </p>
  </div>

  <!-- Interactive CTA with Angled Glasses on Right Edge -->
  <div class="flex items-center gap-3 pt-2">
    <div class="group relative inline-flex items-center">
      
      <!-- Primary Mailto Button (Tight equal px-5 padding) -->
      <a 
        href={`mailto:${email}`}
        class="relative inline-flex items-center h-11 px-5 rounded-xl bg-slate-800/80 hover:bg-sky-950/80 border border-sky-500/40 text-sky-400 transition-all duration-300 shadow-lg shadow-sky-500/10 overflow-hidden z-10"
      >
        <!-- Idle Text: "Send Email" -->
        <span class="font-medium text-sm text-slate-200 group-hover:hidden whitespace-nowrap">
          Send Email
        </span>

        <!-- Hover Text: Full Email String -->
        <span class="hidden group-hover:inline-block font-mono text-xs text-sky-300 font-semibold tracking-wide truncate">
          {email}
        </span>
      </a>

      <!-- RETRO SUNGLASSES: Resting at right edge, lifting up/out on hover -->
      <div class="absolute -right-3 -top-3 z-20 transition-all duration-300 ease-out rotate-12 group-hover:-translate-y-4 group-hover:rotate-0 group-hover:-right-1 filter drop-shadow-[0_0_8px_rgba(56,189,248,0.6)] pointer-events-none">
        <svg class="w-12 h-7 text-sky-400 fill-current" viewBox="0 0 64 32">
          <!-- Top Brow / Frame Bar -->
          <path d="M 2 4 H 62 L 58 10 H 6 L 2 4 Z" class="fill-sky-400"/>
          <!-- Left Lens Frame -->
          <path d="M 5 10 L 29 10 L 25 28 L 10 28 Z" class="fill-slate-950 stroke-sky-400 stroke-[2]"/>
          <!-- Right Lens Frame -->
          <path d="M 35 10 L 59 10 L 54 28 L 39 28 Z" class="fill-slate-950 stroke-sky-400 stroke-[2]"/>
          <!-- Shutter Lines - Left Lens -->
          <line x1="7" y1="15" x2="27" y2="15" stroke="#38bdf8" stroke-width="1.5" />
          <line x1="8" y1="19" x2="26" y2="19" stroke="#38bdf8" stroke-width="1.5" />
          <line x1="10" y1="23" x2="24" y2="23" stroke="#38bdf8" stroke-width="1.5" />
          <!-- Shutter Lines - Right Lens -->
          <line x1="37" y1="15" x2="57" y2="15" stroke="#38bdf8" stroke-width="1.5" />
          <line x1="38" y1="19" x2="55" y2="19" stroke="#38bdf8" stroke-width="1.5" />
          <line x1="40" y1="23" x2="52" y2="23" stroke="#38bdf8" stroke-width="1.5" />
          <!-- Nose Bridge -->
          <path d="M 29 10 H 35 V 13 H 29 Z" class="fill-sky-400"/>
        </svg>
      </div>

      <!-- Quick Copy Button (Slides out horizontally on hover) -->
      <button
        id="copy-email-btn"
        data-email={email}
        title="Copy email address"
        class="max-w-0 opacity-0 group-hover:max-w-xs group-hover:opacity-100 group-hover:ml-2.5 h-11 px-3 rounded-xl bg-slate-800/80 hover:bg-slate-700 border border-sky-500/40 text-sky-300 hover:text-white transition-all duration-300 ease-out overflow-hidden flex items-center justify-center shrink-0 z-10"
      >
        <svg id="copy-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
        </svg>
        <svg id="check-icon" class="w-4 h-4 text-emerald-400 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
      </button>

    </div>
  </div>
</div>

      <!-- External Networks & Profiles Card -->
      <div class="p-8 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-purple-500/50 transition-all duration-300 flex flex-col justify-between shadow-xl">
        <!-- Top Icon -->
        <div class="w-12 h-12 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 mb-6">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
          </svg>
        </div>

        <!-- Content & Collapsible Links Container -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
          <!-- Text Content (Left Side) -->
          <div class="max-w-xs">
            <h4 class="text-xl font-bold text-slate-100 mb-2">Online Profiles</h4>
            <p class="text-slate-400 text-sm leading-relaxed">
              Explore code repositories, technical write-ups, and professional networking profiles.
            </p>
          </div>

          <!-- Vertically Stacked Hover-Expanding Link Pills (Right Side) -->
          <div class="flex flex-col items-end gap-3 shrink-0">
            
            <!-- GitHub Box -->
            <a 
              href={githubUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="group flex items-center h-10 px-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-800 border border-slate-700/60 text-slate-300 hover:text-white transition-all duration-300 ease-out shadow-md hover:shadow-sky-500/10"
            >
              <!-- Fixed Icon -->
              <div class="w-5 h-5 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
              </div>
              <!-- Expandable Text & Arrow Content -->
              <div class="max-w-0 opacity-0 group-hover:max-w-xs group-hover:opacity-100 group-hover:ml-2.5 flex items-center gap-2 transition-all duration-300 ease-out overflow-hidden whitespace-nowrap text-xs font-medium">
                <span>GitHub</span>
                <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-white group-hover:translate-x-0.5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </div>
            </a>

            <!-- LinkedIn Box -->
            <a 
              href={linkedinUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="group flex items-center h-10 px-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-800 border border-slate-700/60 text-slate-300 hover:text-sky-400 transition-all duration-300 ease-out shadow-md hover:shadow-sky-500/10"
            >
              <!-- Fixed Icon (Full 'in' monogram) -->
              <div class="w-5 h-5 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.6a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24z"/>
                </svg>
              </div>
              <!-- Expandable Text & Arrow Content -->
              <div class="max-w-0 opacity-0 group-hover:max-w-xs group-hover:opacity-100 group-hover:ml-2.5 flex items-center gap-2 transition-all duration-300 ease-out overflow-hidden whitespace-nowrap text-xs font-medium">
                <span>LinkedIn</span>
                <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-sky-400 group-hover:translate-x-0.5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </div>
            </a>

            <!-- Medium Box -->
            <a 
              href={mediumUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="group flex items-center h-10 px-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-800 border border-slate-700/60 text-slate-300 hover:text-emerald-400 transition-all duration-300 ease-out shadow-md hover:shadow-emerald-500/10"
            >
              <!-- Fixed Icon -->
              <div class="w-5 h-5 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42c1.87 0 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>
              </div>
              <!-- Expandable Text & Arrow Content -->
              <div class="max-w-0 opacity-0 group-hover:max-w-xs group-hover:opacity-100 group-hover:ml-2.5 flex items-center gap-2 transition-all duration-300 ease-out overflow-hidden whitespace-nowrap text-xs font-medium">
                <span>Medium</span>
                <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-emerald-400 group-hover:translate-x-0.5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </div>
            </a>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyIcon = document.getElementById('copy-icon');
  const checkIcon = document.getElementById('check-icon');

  if (copyBtn) {
    copyBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const email = copyBtn.getAttribute('data-email') || '';
      
      navigator.clipboard.writeText(email).then(() => {
        copyIcon?.classList.add('hidden');
        checkIcon?.classList.remove('hidden');

        setTimeout(() => {
          copyIcon?.classList.remove('hidden');
          checkIcon?.classList.add('hidden');
        }, 2000);
      });
    });
  }
</script>