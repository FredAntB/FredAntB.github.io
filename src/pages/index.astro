---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Frederick Balderrama | Portfolio">
	<section class="space-y-6 py-8">
		<div class="inline-flex items-center gap-2 px-3 py-1 rounder-full bg-cyan-950/60 border border-cyan-800/50 text-cyan-400 text-xs font-mono">
			<span>🚀</span> Layout Shell Initialized
		</div>

		<h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white">
			Architecting Modern Systems & <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-indigo-400">Micro-Frontends</span>
		</h1>
		
		<p class="max-w-2xl text-lg text-slate-400 leading-relaxed">
			Testing the base shell. before progressing with next dev steps.
		</p>
	</section>
</Layout>
